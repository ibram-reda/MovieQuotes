<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MovieQuotes.UI.ViewModels"
             xmlns:vlc="using:LibVLCSharp.Avalonia"
             xmlns:controls="using:MovieQuotes.UI.Views.Controls"
             x:DataType="vm:MovieDetailsViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MovieQuotes.UI.Views.MovieDetailsView">

  <Grid RowDefinitions="*,auto,auto"  Background="#333">

    <vlc:VideoView Grid.Row="0"
         MediaPlayer="{Binding MainMediaPlayer}"
         VerticalAlignment="Stretch"
         HorizontalAlignment="Stretch">
    </vlc:VideoView>
    
    <TextBlock Grid.Row="1"
               Foreground="Orange"
               HorizontalAlignment="Center"
               FontSize="24"
               FontWeight="Bold"
               Text="{Binding CurrentPhrase.Text}"/>
    

    <Grid Grid.Row="2"
          RowDefinitions="50,50"
          ColumnDefinitions="auto,*,auto"
          Margin="10">
      <Slider Grid.Row="0" 
              Grid.ColumnSpan="3"
              Margin="0"
              
              HorizontalAlignment="Stretch" 
              Maximum="{Binding MovieLength}"
              Value="{Binding CurrentTime}" />
      
      <controls:MediaPlayerControls 
        Grid.Row="1"
        Grid.Column="0"
        Player="{Binding MainMediaPlayer}" />

      <StackPanel Orientation="Horizontal"
                  Grid.Column="2"
                  Grid.Row="1">
        <TextBlock Text="{Binding CurrentTime,Converter={StaticResource LongToTimeConverter}}"/>

        <TextBlock Text=" of "/>
        <TextBlock Text="{Binding MovieLength,Converter={StaticResource LongToTimeConverter}}"/>
        
      </StackPanel>
    </Grid>
    
  </Grid>
</UserControl>
