<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MovieQuotes.UI.Views.MoviesListView"
             xmlns:vm ="using:MovieQuotes.UI.ViewModels"
             xmlns:models ="using:MovieQuotes.Application.Features.Movies.Models"
             x:DataType="vm:MoviesListViewModel"
             >
  
  
 
  <UserControl.DataTemplates>
    <DataTemplate DataType="models:MovieInfo" >
      <Button Classes="contentbtn" 
              CommandParameter="{Binding Id}"
              Command="{Binding $parent[ListBox].((vm:MoviesListViewModel)DataContext).DisplayMovieDetailsCommand}">       
      <StackPanel Spacing="5" Height="200">
        <Image Width="100"  DockPanel.Dock="Top" Source="{Binding CoverUrl,Converter={StaticResource PathToBitmapConverter}}" />
        <TextBlock Text="{Binding Title}" Width="100" TextWrapping="Wrap"/>
      </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.DataTemplates> 
  <Grid RowDefinitions="auto,* ,auto">

    <Grid ColumnDefinitions="auto,*,auto,auto" Margin="5">
      <TextBlock Text="Base Folder:" 
                 VerticalAlignment="Center" 
                 Margin="5" />
      <TextBox Grid.Column="1" 
               Text="{Binding BaseFolder}"
               Watermark="Folder contains movies"/>  
      <Button Grid.Column="2" Content="change folder" Command="{Binding ChoseFolderCommand}" />
      <Button Grid.Column="3" Content="sync"  Command="{Binding SyncCommand }" />
    </Grid>


    <Border Grid.Row="1">
      <ScrollViewer Margin="10,0,10,10">
        
      <Grid   RowDefinitions="auto,auto" >
        <Grid Grid.Row="0" RowDefinitions="auto,auto" IsVisible="{Binding NeedToSync }">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Movie Out Of Sync" Classes="title" />
            <TextBlock Text="{Binding OutOfSyncMovies.Count,StringFormat='({0} movies)'}" VerticalAlignment="Center"/>
          </StackPanel>
          <ListBox Grid.Row="1"
                 ItemsSource="{Binding OutOfSyncMovies}">

            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="5" Height="250">
                  <Image Width="100" 
                         DockPanel.Dock="Top" 
                         Source="{Binding CoverUrl,Converter={StaticResource PathToBitmapConverter}}" />
                  <TextBlock Text="{Binding Title}" 
                             Height="50"
                             Width="100" 
                             TextWrapping="Wrap"/>
                  <Button Content="Add To Database"
                          Command="{Binding $parent[ListBox].((vm:MoviesListViewModel)DataContext).SelectCommand}"
                          CommandParameter="{Binding .}"/>
                        
                </StackPanel>
              </DataTemplate> 
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Center" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="auto,auto"> 
           <StackPanel Orientation="Horizontal">
            <TextBlock Text="Movie In DB" Classes="title" />
            <TextBlock Text="{Binding DBMovies.Count,StringFormat='({0} movies)'}" VerticalAlignment="Center"/>

             <TextBox Watermark="search name 🔍"
                      Height="10"
                      Width="200"
                      Margin="10 0"
                      Text="{Binding FilterText}">
               <TextBox.KeyBindings>
                 <KeyBinding Gesture="Enter" Command="{Binding GetAllMoviesCommand}"/>
               </TextBox.KeyBindings>
             </TextBox>
           </StackPanel>

          <ListBox Grid.Row="1"
                 ItemsSource="{Binding DBMovies}">
                
            <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
           </ListBox>
        </Grid>
      </Grid>
      </ScrollViewer>
    </Border>
    
     
  </Grid>
</UserControl>
