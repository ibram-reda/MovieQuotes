<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MovieQuotes.UI.ViewModels.Dialogues"
             xmlns:controls="using:MovieQuotes.UI.Views.Controls"
             x:DataType="vm:PhraseEditDialogueViewModel"             
             mc:Ignorable="d" d:DesignWidth="400" 
             d:DesignHeight="250"
             x:Class="MovieQuotes.UI.Views.Dialogues.PhraseEditDialogueView">

  <StackPanel  Spacing="5"
        Margin="10">
    <TextBlock Text="Edit Phrase" 
               Classes="title" />
    <Grid RowDefinitions="auto,auto,auto,auto"
        ColumnDefinitions="auto,*,auto">

    <TextBlock Grid.Row="0"
               Grid.Column="0"
               Text="Text" />
    <TextBox Grid.Row="0"
             Grid.Column="1"
             Grid.ColumnSpan="2"
             Text="{Binding PhraseText,Mode=TwoWay}"/>
    
    <controls:TimeSpanControl Grid.Row="1" 
                      Grid.ColumnSpan="3"
                      Text="Start Time"
                      Time="{Binding StartTime,Mode=TwoWay}"/>


      <controls:TimeSpanControl Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Text="End Time  "
                        Time="{Binding EndTime,Mode=TwoWay}"/>
    
    
  </Grid>

    <StackPanel Orientation="Horizontal"
                Spacing="10">
      <Button Content="Save changes" Command="{Binding SaveCommand}"/>
      <Button Content="Cancel" Command="{Binding CancelCommand}"/>
    </StackPanel>
  </StackPanel>
</UserControl>
