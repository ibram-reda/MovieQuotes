<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MovieQuotes.UI.ViewModels"
        xmlns:models="using:MovieQuotes.UI.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="450"
        x:Class="MovieQuotes.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        MinWidth="650"
        MinHeight="450"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}">


  <Grid ColumnDefinitions="Auto,*" Background="{DynamicResource AppBackgroundColor}">

    <!-- Navigation Menu -->
    <Border Grid.Column="0"
            Width="{Binding NavigationMenuWidth}"
            IsVisible="{Binding RenderNavigationBar}"
            Background="{DynamicResource CardBackgroundColor}">
      <Grid RowDefinitions="Auto,*">
        <Button Classes="menu-toggle"
                Command="{Binding ToggleNavigationMenuCommand}"
                Content="☰"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Margin="8" />

        <StackPanel Grid.Row="1"
                    Classes="navigation"
                    VerticalAlignment="Top">
          <ItemsControl ItemsSource="{Binding NavigationItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:NavigationItem">
                <Button Classes="link"
                        Classes.active="{Binding IsActive}"
                        Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal">
                    <PathIcon Data="{Binding IconName, Converter={StaticResource NavigationIconConverter}}" />
                    <Label Content="{Binding DisplayName}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding $parent[Window].DataContext.IsNavigationMenuOpen}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Button Content="Clear Error"
                  Command="{Binding CurrentViewModel.ClearErrorsCommand}" />

          <ToggleSwitch IsChecked="{Binding IsDarkMode}"
                        OnContent="Dark"
                        OffContent="Light" />
        </StackPanel>

        
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="*,Auto">
      <!--Content-->
      <ContentControl Grid.Row="0"
                      Content="{Binding CurrentViewModel}"/>

      <!-- Dialog View -->
      <Panel Grid.Row="0" IsVisible="{Binding CurrentViewModel.ShowEditDialog}"
             Background="{DynamicResource CardBackgroundColor}"
             Width="700"
             VerticalAlignment="Center">
        <Border BorderThickness="1"
                BorderBrush="{DynamicResource PrimaryAccentPurpleColor}"
                CornerRadius="{StaticResource StandardCornerRadius}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Disabled" >
            <ContentControl Content="{Binding CurrentViewModel.Dialogue}"/>
          </ScrollViewer>
        </Border>
      </Panel>

      <!--overlay Is Bussy-->
      <Border Grid.Row="0" IsVisible="{Binding CurrentViewModel.IsBusy}"  >
        <Grid Background="#30303091" >
          <TextBlock VerticalAlignment="Center"
                     Background="{DynamicResource SurfeceBackground}"
                     Foreground="{DynamicResource AppForeground}"
                     Padding="5"
                     FontSize="24"
                     HorizontalAlignment="Center"
                     Text="the current view is Bussy ..."/>

        </Grid>

      </Border>

      <!--Error Messages-->
      <ItemsControl Grid.Row="1"
                    ItemsSource="{Binding CurrentViewModel.ErrorMessages}"
                    Foreground="Red"/>
    </Grid>
  </Grid>
</Window>
