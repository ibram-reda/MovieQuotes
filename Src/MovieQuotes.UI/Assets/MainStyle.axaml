<Styles xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="using:MovieQuotes.UI.Converters">
  <Design.PreviewWith>
    <Border Padding="20" Background="{DynamicResource AppBackground}">
      <!-- Add Controls for Previewer Here -->
      <StackPanel Background="{DynamicResource SurfeceBackground}" >
        <TextBlock Classes="title" >this is title</TextBlock>
        <TextBlock Classes="subtitle" >this is subtitle</TextBlock>
        <Button Classes="link" >like button</Button>
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10">
          <Button Classes="saveBtn" Content="Save"/>
          <Button Classes="cancelBtn" Content="Cancel"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <Styles.Resources>
    <converters:NavigationContentAlignmentConverter x:Key="NavigationContentAlignmentConverter" />
    <CornerRadius x:Key="StandardCornerRadius">8</CornerRadius>
  </Styles.Resources>

  <Style Selector="Grid.display-center">
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Title -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize"  Value="30"/>
    <Setter Property="FontWeight"  Value="Bold"/>
    <Setter Property="Margin"  Value="0,10,0,10"/>
  </Style>
  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize"  Value="20"/>
    <Setter Property="FontWeight"  Value="Bold"/>
    <Setter Property="Margin"  Value="0,10,0,10"/>
  </Style>

  <Style Selector="TextBlock.info-text">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="Margin" Value="0 10 0 0"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
 
  <Style Selector="TextBlock.copyable" >
    <Setter Property="Cursor" Value="Hand"/>
    <Style Selector="^:pointerover" >
      <Setter Property="Background" Value="LightBlue"/>
    </Style>
  </Style>

  <!--Butttons-->
  <Style Selector="Button:pointerover">
    <Setter Property="Cursor" Value="Hand"/>

  </Style>
  <Style Selector="Button.saveBtn">
    <Setter Property="Background" Value="{DynamicResource CorrectGreenBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
  </Style>

  <Style Selector="Button.cancelBtn">
    <Setter Property="Background" Value="{DynamicResource ErrorRedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
  </Style>

  <Style Selector="Button.primary-action">
    <Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="CornerRadius" Value="{StaticResource StandardCornerRadius}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.secondary-action">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="CornerRadius" Value="{StaticResource StandardCornerRadius}" />
  </Style>

  <Style Selector="Button.form-action">
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="CornerRadius" Value="{StaticResource StandardCornerRadius}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.save-action">
    <Setter Property="Background" Value="{DynamicResource CorrectGreenBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.cancel-action">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.section-card">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource StandardCornerRadius}" />
  </Style>

  <Style Selector="TextBlock.detail-label">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="TextBlock.detail-value">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background"  Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="{ReflectionBinding IsNavigationMenuOpen, Converter={x:Static converters:NavigationContentAlignmentConverter.Instance}}"/>
    <Style Selector="^:pointerover /template/ContentPresenter">
      <Setter Property="Background" Value="gray"/>
    </Style>
  </Style>

  <Style Selector="Button.link.active /template/ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryAccentPurpleColor}"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
  </Style>

  <Style Selector="StackPanel.navigation" >
    <Setter Property="Orientation" Value="Vertical"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Margin" Value="0,0,0,5"/>
    <Setter Property="Spacing" Value="4"/>
  </Style>

  <Style Selector="Button.menu-toggle">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0,8"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <Style Selector="Button.nav-icon-button">
    <Setter Property="Width" Value="48"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <Style Selector="Button.contentbtn">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Margin" Value="5"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand" />

    <Style Selector="^:pointerover /template/ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </Style>
</Styles>
