<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20" Background="{DynamicResource AppBackground}">
      <!-- Add Controls for Previewer Here -->
      <StackPanel Background="{DynamicResource SurfeceBackground}" >
        <TextBlock Classes="title" >this is title</TextBlock>
        <Button Classes="link" >like button</Button>
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10">
          <Button Classes="saveBtn" Content="Save"/>
          <Button Classes="cancelBtn" Content="Cancel"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <Style Selector="Grid.display-center">
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Title -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize"  Value="30"/>
    <Setter Property="FontWeight"  Value="Bold"/>
    <Setter Property="Margin"  Value="0,10,0,10"/>
  </Style>

  <Style Selector="TextBlock.info-text">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="Margin" Value="0 10 0 0"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
 
  <Style Selector="TextBlock.copyable" >
    <Setter Property="Cursor" Value="Hand"/>
    <Style Selector="^:pointerover" >
      <Setter Property="Background" Value="LightBlue"/>
    </Style>
  </Style>

  <!--Butttons-->
  <Style Selector="Button:pointerover">
    <Setter Property="Cursor" Value="Hand"/>

  </Style>
  <Style Selector="Button.saveBtn">
    <Setter Property="Background" Value="{DynamicResource CorrectGreenBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
  </Style>

  <Style Selector="Button.cancelBtn">
    <Setter Property="Background" Value="{DynamicResource ErrorRedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background"  Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Style Selector="^:pointerover /template/ContentPresenter">
      <Setter Property="Background" Value="gray"/>
    </Style>
  </Style>

  <Style Selector="StackPanel.navigation" >
    <Setter Property="Orientation" Value="Vertical"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Margin" Value="0,0,0,5"/>
    <Setter Property="Spacing" Value="4"/>
  </Style>

  <Style Selector="Button.menu-toggle">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0,8"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <Style Selector="Button.nav-icon-button">
    <Setter Property="Width" Value="48"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource AppForeground}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <Style Selector="Button.contentbtn">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Margin" Value="5"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand" />

    <Style Selector="^:pointerover /template/ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </Style>
</Styles>
