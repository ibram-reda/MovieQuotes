<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MovieQuotes.UI.Features.Study.BrowseStudyMaterials"
             xmlns:movieModels="using:MovieQuotes.Application.Features.Movies.Models"
             xmlns:studyModels="using:MovieQuotes.Application.Features.Study"
             xmlns:controls="using:MovieQuotes.UI.Views.Controls"
             x:Class="MovieQuotes.UI.Features.Study.BrowseStudyMaterials.BrowseStudyMaterialsView"
             x:DataType="vm:BrowseStudyMaterialsViewModel"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="650"
             Loaded="BrowseStudyMaterialsView_Loaded">

  <UserControl.Styles>
    <Style Selector="Border.draft">
      <Setter Property="Background" Value="{DynamicResource ErrorStatusColor}"/>
    </Style>
    <Style Selector="TextBox.filter">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="MinWidth" Value="150" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,5,0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <Border Padding="12"
            Background="{DynamicResource CardBackgroundColor}"
            CornerRadius="4">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Study materials" Classes="title" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TotalCount, StringFormat='({0})'}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Margin="0,12,0,0">
          <TextBlock Text="Movie ID" Classes="label" />
          <ComboBox Classes="filter"
                    ItemsSource="{Binding Movies}"
                    SelectedItem="{Binding SelectedMovie, Mode=TwoWay}"
                    PlaceholderText="Any movie">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="movieModels:MovieWithStudyMaterialCount">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" >
                    <Image Width="30" Source="{Binding CoverUrl,Converter={StaticResource PathToBitmapConverter}}"/>
                    <TextBlock Text="{Binding Title}"
                               Width="200"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StudyMaterialCount}"
                               VerticalAlignment="Center"
                               Foreground="Yellow"/>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Level" Classes="label" />
          <TextBox Classes="filter" Text="{Binding LevelFilter, Mode=TwoWay}" PlaceholderText="Any level" />
          <TextBlock Text="Part of speech" Classes="label" />
          <ComboBox Classes="filter"
                    ItemsSource="{Binding PartOfSpeechCounts}"
                    SelectedItem="{Binding SelectedPartOfSpeech, Mode=TwoWay}"
                    PlaceholderText="Any type">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="studyModels:PartOfSpeechCountDto">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding PartOfSpeech}" />
                  <TextBlock Text="{Binding Count, StringFormat='({0})'}" Opacity="0.7" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBox Classes="filter" Width="220"
                   Text="{Binding SearchText, Mode=TwoWay}"
                   PlaceholderText="Search materials">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ApplyFiltersCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Content="Filter" Command="{Binding ApplyFiltersCommand}" Margin="0,0,8,0" />
          <Button Content="Clear" Command="{Binding ClearFiltersCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
      <ItemsControl ItemsSource="{Binding Materials}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="330"
                    Margin="0,0,12,12"
                    Padding="14"
                    Classes.draft="{Binding IsDraft}"
                    Background="{DynamicResource CardBackgroundColor}"
                    CornerRadius="4">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                <Grid ColumnDefinitions="*,auto" >
                       <TextBlock Text="{Binding Origin}"
                           FontSize="18"
                           FontWeight="Bold"
                           TextWrapping="Wrap" />
                  
                        <TextBlock Text="{Binding Content}"
                          IsVisible="{Binding Origin, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                           FontSize="18"
                           FontWeight="Bold"
                           TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding Level}" />
                        
                </Grid>
                
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,10,0,0">
                  <TextBlock Text="{Binding PartOfSpeech}" Foreground="{DynamicResource SecondaryTextColor}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ContentArabicTranslation}"
                          FlowDirection="RightToLeft"
                          VerticalAlignment="Top"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="{Binding Definition}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />

                <GridSplitter Grid.Row="3" BorderThickness="1" BorderBrush="{DynamicResource SecondaryTextColor}" Height="1" />

                
                <TextBlock Grid.Row="4"
                           Text="{Binding Examples}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Opacity="0.8" />
                
                <!--Button Arrea-->
                <Grid Grid.Row="5" ColumnDefinitions="auto,auto,*,auto" VerticalAlignment="Bottom">
                  <Button Grid.Column="0">
                    <PathIcon Data="{StaticResource edit_regular}" />
                  </Button>

                  <Button Grid.Column="1" >+</Button>

                  <Button Grid.Column="3" ></Button>


                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="2"
          ColumnDefinitions="Auto,*,Auto"
          Margin="0,12,0,0">
      <controls:PaginationControl Grid.Column="1"
                                  CurrentPage="{Binding CurrentPageNumber}"
                                  TotalCount="{Binding TotalCount}"
                                  PageSize="{Binding ResultPerPage}"
                                  PageChangedCommand="{Binding GoToPageCommand}" />
      <TextBlock Grid.Column="2" Background="Green"
                 Text="{Binding Materials.Count, StringFormat='Showing {0}'}"
                 VerticalAlignment="Center"
                 Margin="12,0,0,0" />
    </Grid>
  </Grid>
</UserControl>