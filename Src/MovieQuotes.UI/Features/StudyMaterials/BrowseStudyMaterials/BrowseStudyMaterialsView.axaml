<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MovieQuotes.UI.Features.StudyMaterials.BrowseStudyMaterials"
             xmlns:movieModels="using:MovieQuotes.Application.Features.Movies.Models"
             xmlns:studyModels="using:MovieQuotes.Application.Features.StudyMaterials"
             xmlns:controls="using:MovieQuotes.UI.Views.Controls"
             x:Class="MovieQuotes.UI.Features.StudyMaterials.BrowseStudyMaterials.BrowseStudyMaterialsView"
             x:DataType="vm:BrowseStudyMaterialsViewModel"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="650"
             Loaded="BrowseStudyMaterialsView_Loaded">

  <!-- Page-specific styles for draft cards, filters, labels, and toolbar actions. -->
  <UserControl.Styles>
    <Style Selector="Border.draft">
      <Setter Property="BorderBrush" Value="{DynamicResource ProgressNeedsWorkOrangeColor}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBox.filter">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="MinWidth" Value="150" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="CheckBox.filter-toggle">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.toolbar-action">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="CornerRadius" Value="{StaticResource StandardCornerRadius}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <!-- Main page layout: filter header, material results, and pagination footer. -->
  <Grid RowDefinitions="Auto,*,Auto" Margin="24,20">
    <!-- Page header and filter controls. -->
    <Border Padding="20"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource PrimaryAccentBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource StandardCornerRadius}">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="16">
        <!-- Page title and total result count. -->
        <Grid ColumnDefinitions="Auto,Auto,*">
          <StackPanel Spacing="3">
            <TextBlock Text="Study materials" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Build and review your personal vocabulary library"
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding TotalCount, StringFormat='{}{0} materials'}"
                     Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Bottom" Margin="12,0,0,3" />
        </Grid>

        <!-- Filters wrap onto multiple lines on narrow screens. -->
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2"
             Orientation="Horizontal"
             ItemSpacing="8"
             LineSpacing="8">
          <TextBlock Text="Movie ID" Classes="label" />
          <ComboBox Classes="filter"
                    ItemsSource="{Binding Movies}"
                    SelectedItem="{Binding SelectedMovie, Mode=TwoWay}" 
                    PlaceholderText="Any movie">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="movieModels:MovieWithStudyMaterialCount">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" >
                    <Image Width="30" IsVisible="{Binding Id}" Source="{Binding CoverUrl,Converter={StaticResource PathToBitmapConverter}}"/>
                    <TextBlock Text="{Binding Title}"
                               Width="200"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StudyMaterialCount}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding Id}"
                               Foreground="{DynamicResource ProgressGoodColor}"/>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Level" Classes="label" />
          <ComboBox Classes="filter"
                    ItemsSource="{Binding Levels}"
                    SelectedItem="{Binding SelectedLevel, Mode=TwoWay}"
                    PlaceholderText="Any level">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="studyModels:LevelFilter">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Level}" />
                  <TextBlock IsVisible="{Binding Count}" Text="{Binding Count, StringFormat='({0})'}" Opacity="0.7" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Part of speech" Classes="label" />
          <ComboBox Classes="filter"
                    ItemsSource="{Binding PartOfSpeechCounts}"
                    SelectedItem="{Binding SelectedPartOfSpeech, Mode=TwoWay}" 
                    PlaceholderText="Any type">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="studyModels:PartOfSpeechCountDto">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding PartOfSpeech}" />
                  <TextBlock IsVisible="{Binding Count}" Text="{Binding Count, StringFormat='({0})'}" Opacity="0.7" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="Order by" Classes="label" />
          <ComboBox Classes="filter"
                    ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SortOrder, Mode=TwoWay}"
                    SelectedIndex="0">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StudyMaterialSortOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <CheckBox Content="Draft only"
                    Classes="filter-toggle"
                    IsChecked="{Binding DraftOnly, Mode=TwoWay}"
                    />
          <CheckBox Content="Vulgar only"
                    Classes="filter-toggle"
                    IsChecked="{Binding VulgarOnly, Mode=TwoWay}"
                    />
          <TextBox Classes="filter" Width="220" MinHeight="34"
                   Text="{Binding SearchText, Mode=TwoWay}"
                   PlaceholderText="Search materials">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ApplyFiltersCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button Classes="toolbar-action primary-action" Content="Apply filters" Command="{Binding ApplyFiltersCommand}" />
          <Button Classes="toolbar-action secondary-action" Content="Clear" Command="{Binding ClearFiltersCommand}" />
        </WrapPanel>
      </Grid>
    </Border>

    <!-- Scrollable study-material result cards. -->
    <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Materials}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- Individual study-material card. -->
            <Border Width="340"
                    Margin="0,0,16,16"
                    Padding="18"
                    Classes.draft="{Binding IsDraft}"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource PrimaryAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource StandardCornerRadius}">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                <!-- Material title and level badge. -->
                <Grid ColumnDefinitions="*,auto" >
                  <TextBlock Text="{Binding Origin}"
                             FontSize="18"
                             FontWeight="Bold"
                             TextWrapping="Wrap" />

                  <TextBlock Text="{Binding Content}"
                             IsVisible="{Binding Origin, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                             FontSize="18"
                             FontWeight="Bold"
                             TextWrapping="Wrap" />
                  <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}"
                          CornerRadius="10" Padding="8,3">
                    <TextBlock Text="{Binding Level}" Foreground="{DynamicResource SecondaryTextBrush}" />
                  </Border>

                </Grid>

                <!-- Part of speech and translation. -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,10,0,0">
                  <TextBlock Text="{Binding PartOfSpeech}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding ContentArabicTranslation}"
                             FlowDirection="RightToLeft"
                             VerticalAlignment="Top"
                             Margin="0,8,0,0"
                             TextWrapping="Wrap" />
                </StackPanel>

                <!-- Definition and source phrase. -->
                <TextBlock Grid.Row="2"
                           Text="{Binding Definition}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />

                <GridSplitter Grid.Row="3" BorderThickness="1" BorderBrush="{DynamicResource SecondaryTextBrush}" Height="1" />

                <PhraseText Grid.Row="4"
                            Text="{Binding SrcPhrase}"
                            Highlight="{Binding Content}"
                            Margin="0 8 0 0"
                            Opacity="0.8"
                            />

                <!-- Card actions: edit, view details, and delete. -->
                <Grid Grid.Row="5" ColumnDefinitions="auto,auto,*,auto" VerticalAlignment="Bottom">
                  <Button Grid.Column="0" Classes="secondary-action"
                          Command="{Binding $parent[ItemsControl].((vm:BrowseStudyMaterialsViewModel)DataContext).EditMaterialCommand}"
                          CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource edit_regular}" />
                  </Button>

                  <Button Grid.Column="1" Classes="secondary-action"
                          Command="{Binding $parent[ItemsControl].((vm:BrowseStudyMaterialsViewModel)DataContext).ShowMaterialDetailsCommand}"
                          CommandParameter="{Binding}"
                          Content="View details" />

                  <!--Delete Button-->
                  <Button Grid.Column="3" Background="Transparent" Foreground="{StaticResource ErrorRedBrush}" 
                          Command="{Binding $parent[ItemsControl].((vm:BrowseStudyMaterialsViewModel)DataContext).DeleteMaterialCommand}"
                          CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource delete_forever_regular}" />
                  </Button>


                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Pagination and visible-item count. -->
    <Grid Grid.Row="2"
          ColumnDefinitions="Auto,*,Auto"
          Margin="0,12,0,0">
      <controls:PaginationControl Grid.Column="1"
                                  CurrentPage="{Binding CurrentPageNumber}"
                                  TotalCount="{Binding TotalCount}"
                                  PageSize="{Binding ResultPerPage}"
                                  PageChangedCommand="{Binding GoToPageCommand}" />
      <TextBlock Grid.Column="2" Foreground="{DynamicResource SecondaryTextBrush}"
                 Text="{Binding Materials.Count, StringFormat='Showing {0}'}"
                 VerticalAlignment="Center"
                 Margin="12,0,0,0" />
    </Grid>
  </Grid>
</UserControl>