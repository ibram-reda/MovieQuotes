<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MovieQuotes.UI.Features.StudyMaterials.StudyMaterialDetails"
             xmlns:study="using:MovieQuotes.Application.Features.StudyMaterials"
             xmlns:phrase="using:MovieQuotes.Application.Features.MoviePhrases.Models"
             xmlns:converters="using:MovieQuotes.UI.Converters"
             x:Class="MovieQuotes.UI.Features.StudyMaterials.StudyMaterialDetails.StudyMaterialDetailsView"
             x:DataType="vm:StudyMaterialDetailsViewModel"
             mc:Ignorable="d"
             d:DesignWidth="900"
             d:DesignHeight="650"
             Background="{DynamicResource AppBackgroundBrush}">
  <UserControl.Resources>
    <converters:StudyReviewDateConverter x:Key="StudyReviewDateConverter" />
    <converters:StudyProgressTypeIconConverter x:Key="StudyProgressTypeIconConverter" />
  </UserControl.Resources>
  <UserControl.Styles>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="24,20">
    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,20">
      <StackPanel Spacing="3">
        <TextBlock Text="Study material details" FontSize="24" FontWeight="Bold" />
        <TextBlock Text="Review vocabulary, learning progress, and related phrases"
                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" />
      </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Classes="primary-action" Content="Start learning"
        Command="{Binding AddToStudyCommand}"
        IsVisible="{Binding !IsBeingStudied}"
        Margin="0,0,8,0" />
      <TextBlock Text="Already studying"
           IsVisible="{Binding IsBeingStudied}"
           Foreground="{DynamicResource CorrectGreenBrush}"
           VerticalAlignment="Center"
           Margin="0,0,8,0" />
          </StackPanel>
      <Button Grid.Column="2" Classes="secondary-action" Content="Back" Command="{Binding BackToPreviousCommand}" />
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="20" MaxWidth="1000" HorizontalAlignment="Center">

        <ItemsControl Foreground="{DynamicResource ErrorRedBrush}" ItemsSource="{Binding ErrorMessages}" />

        <Border IsVisible="{Binding Details}" Padding="24" Classes="section-card">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnDefinitions="140,*" RowSpacing="10" ColumnSpacing="16">
            <TextBlock Grid.Row="0" Classes="detail-label" Text="Content" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Details.Content}" TextWrapping="Wrap" />

            <TextBlock Grid.Row="1" Classes="detail-label" Text="Definition" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Details.Definition}" TextWrapping="Wrap" />

            <TextBlock Grid.Row="2" Classes="detail-label" Text="Arabic content" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Details.ContentArabicTranslation}" FlowDirection="RightToLeft" TextWrapping="Wrap" />

            <TextBlock Grid.Row="3" Classes="detail-label" Text="Part of speech" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Details.PartOfSpeech}" />

            <TextBlock Grid.Row="4" Classes="detail-label" Text="Origin" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Details.Origin}" />

            <TextBlock Grid.Row="5" Classes="detail-label" Text="Level" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Details.Level}" />

            <TextBlock Grid.Row="6" Classes="detail-label" Text="Pronunciation" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Details.Pronunciation}" />

            <TextBlock Grid.Row="7" Classes="detail-label" Text="Synonyms" />
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Details.Synonyms}" TextWrapping="Wrap" />

            <TextBlock Grid.Row="8" Classes="detail-label" Text="Examples" />
            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Details.Examples}" TextWrapping="Wrap" />

            <TextBlock Grid.Row="9" Classes="detail-label" Text="Notes" />
            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Details.Notes}" TextWrapping="Wrap" />

            <TextBlock Grid.Row="10" Classes="detail-label" Text="Tags" />
            <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Details.Tags}" TextWrapping="Wrap" />

            <TextBlock Grid.Row="11" Classes="detail-label" Text="Draft" />
            <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding Details.IsDraft}" />

            <TextBlock Grid.Row="12" Classes="detail-label" Text="Vulgar" />
            <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding Details.IsVulgar}" />
          </Grid>
        </Border>

        <StackPanel IsVisible="{Binding IsBeingStudied}" Spacing="12">
          <TextBlock Text="Learning progress" FontSize="20" FontWeight="SemiBold" />
           
            <Border IsVisible="{Binding !HasProgressRecords}" Padding="18" Classes="section-card"
                  BorderBrush="{DynamicResource ProgressBackgroundColor}"
                  BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="4">
              <TextBlock Text="Not started" FontSize="18" FontWeight="Bold" />
              <TextBlock Text="Your learning progress will appear here after your first review."
                         Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Details.Progresses}" HorizontalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemWidth="360" ItemSpacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="study:StudyProgress">
                <Border Width="360" MinWidth="280" Padding="18" Margin="8"
                  Classes="section-card"
                        BorderBrush="{DynamicResource ProgressBackgroundColor}"
                        BorderThickness="1" CornerRadius="8">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding ProgressType, Converter={StaticResource StudyProgressTypeIconConverter}}"
                                 FontSize="20" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding ProgressType}" FontSize="17" FontWeight="Bold"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="15" FontWeight="SemiBold"
                                 Foreground="{DynamicResource PrimaryAccentBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <ProgressBar Value="{Binding Strength}" Minimum="0" Maximum="100" Height="10"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryAccentBrush}"
                                   Background="{DynamicResource ProgressBackgroundColor}" />
                      <TextBlock Grid.Column="1" Text="{Binding Strength, StringFormat='{}{0}%'}"
                                 FontWeight="Bold" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding Repetitions, StringFormat='🔥 {0} successful reviews'}"
                               FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="3" Text="{Binding NextReviewAt, Converter={StaticResource StudyReviewDateConverter}}"
                               Opacity="0.8" />
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="16" Opacity="0.65">
                      <TextBlock Text="{Binding ReviewCount, StringFormat='Reviews: {0}'}" />
                      <TextBlock Text="{Binding LapseCount, StringFormat='Lapses: {0}'}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
          <StackPanel Grid.Column="0" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Related phrases" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Details.MaterialPhrases.Count, StringFormat='({0})'}" VerticalAlignment="Center"/>
            </StackPanel>
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Details.MaterialPhrases}">
                <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="study:StudyMaterialPhrase">
                  <Border Padding="16" Margin="0,0,0,10" Classes="section-card">
                    <Grid ColumnDefinitions="20,96,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                      <TextBlock Grid.RowSpan="4" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding Sequance, StringFormat='#{0}'}" Opacity="0.7" />
                      <Image Grid.Column="1" Grid.RowSpan="4" Width="80" Height="60" Stretch="UniformToFill"
                             Source="{Binding MovieCoverUrl, Converter={StaticResource PathToBitmapConverter}}" />
                      <TextBlock Grid.Column="2" Text="{Binding MovieTitle}" FontWeight="Bold" TextWrapping="Wrap" />
                      <PhraseText Grid.Row="1" Grid.Column="2" Text="{Binding PhraseText}" Highlight="{Binding $parent[ItemsControl].((vm:StudyMaterialDetailsViewModel)DataContext).Details.Content}"/>
                      <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ArPhraseTranslation}" FlowDirection="RightToLeft" TextWrapping="Wrap" />
                      <Button Grid.Column="3" Grid.RowSpan="4"
                              Classes="secondary-action"
                              Content="Unlink"
                              VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:StudyMaterialDetailsViewModel)DataContext).UnlinkPhraseCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>

          <StackPanel Grid.Column="1" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Matching phrases" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding MatchingPhrases.Count, StringFormat='({0})'}" VerticalAlignment="Center"/>
            </StackPanel>
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding MatchingPhrases}">
                <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="phrase:Phrase">
                  <Border Padding="16" Margin="0,0,0,10" Classes="section-card">
                    <Grid ColumnDefinitions="96,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                      <Image Grid.RowSpan="3" Width="80" Height="60" Stretch="UniformToFill"
                             Source="{Binding MovieCoverUrl, Converter={StaticResource PathToBitmapConverter}}" />
                      <TextBlock Grid.Column="1" Text="{Binding MovieName}" FontWeight="Bold" TextWrapping="Wrap" />
                      <PhraseText Grid.Row="1" Grid.Column="1" Text="{Binding Text}" Highlight="{Binding $parent[ItemsControl].((vm:StudyMaterialDetailsViewModel)DataContext).Details.Content}"/>
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Sequence, StringFormat='Sequence: {0}'}" Opacity="0.7" />
                      <Button Grid.Column="2" Grid.RowSpan="3" Classes="secondary-action"
                              Content="Play"
                              VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:StudyMaterialDetailsViewModel)DataContext).PlayPhraseCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="3" Grid.RowSpan="3" Classes="primary-action"
                              Content="Add"
                              VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:StudyMaterialDetailsViewModel)DataContext).AddPhraseCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
