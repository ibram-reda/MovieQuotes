<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:MovieQuotes.UI.Features.Study"
             x:DataType="vm:RecognitionViewModel"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="800"
             x:Name="root"
             x:Class="MovieQuotes.UI.Features.Study.RecognitionView"
             Loaded="UserControl_Loaded">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource StandardCornerRadius}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="Background" Duration="0:0:0.2"/></Transitions>
            </Setter>
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.88"/>
        </Style>

        <Style Selector="Button.AnswerOption">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource StandardCornerRadius}"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.AnswerOption:pointerover">
            <Setter Property="Background" Value="{DynamicResource ActiveAccentPurpleColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.AnswerOption.Correct">
            <Setter Property="Background" Value="{DynamicResource CorrectGreenBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.AnswerOption.Incorrect">
            <Setter Property="Background" Value="{DynamicResource ErrorRedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.ReviewOption">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style Selector="Button.ReviewOption.Again">
            <Setter Property="Background" Value="{DynamicResource ProgressNeedsWorkRedColor}"/>
        </Style>

        <Style Selector="Button.ReviewOption.Hard">
            <Setter Property="Background" Value="{DynamicResource ProgressNeedsWorkOrangeColor}"/>
        </Style>

        <Style Selector="Button.ReviewOption.Good">
            <Setter Property="Background" Value="{DynamicResource ProgressGoodColor}"/>
        </Style>

        <Style Selector="Button.ReviewOption.Perfect">
            <Setter Property="Background" Value="{DynamicResource ProgressStrongColor}"/>
        </Style>
    </UserControl.Styles>

    <!-- Main Layout -->
    <Grid RowDefinitions="Auto, Auto, *" Margin="24,20">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto, Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{StaticResource lightbulb_regular}" FontSize="22" 
                         Foreground="{DynamicResource PrimaryAccentBrush}" VerticalAlignment="Center" />
                <StackPanel Spacing="2">
                    <TextBlock Text="Recognition" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Choose the phrase that matches the meaning" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Card Counter -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentPhraseIndex, StringFormat='Card {0} / '}" 
                          Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                <TextBlock Text="{Binding TotalPhrases}" 
                          Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
            </StackPanel>

            <!-- Restart Button -->
            <Button Grid.Column="3" 
                   Command="{Binding RestartCommand}"
                   IsEnabled="{Binding !IsBusy}"
                   ToolTip.Tip="Restart">
                <PathIcon Data="{StaticResource arrow_sync_regular}" FontSize="16"/>
            </Button>
        </Grid>

        <!-- Progress Bar -->
        <ProgressBar Grid.Row="1" 
                    Value="{Binding CurrentPhraseIndex}" 
                    Maximum="{Binding TotalPhrases}"
                Height="6"
                Foreground="{DynamicResource PrimaryAccentBrush}"
                Background="{DynamicResource ProgressBackgroundColor}"
                Margin="0,0,0,20"/>

        <!-- Error Message -->
        <TextBlock Grid.Row="2" 
                  Text="{Binding ErrorMessage}"
                  Foreground="{DynamicResource ErrorRedBrush}"
                  IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  TextWrapping="Wrap"
                  Margin="0,0,0,16"/>

        <!-- Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Center">

                <!-- Loading Indicator -->
                <StackPanel IsVisible="{Binding IsBusy}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <TextBlock Text="Loading recognition exercises..." 
                              Foreground="{DynamicResource SecondaryTextBrush}"
                              FontSize="16"
                              TextAlignment="Center"/>
                </StackPanel>

                <!-- Recognition Exercise Card -->
                <Border IsVisible="{Binding CurrentPhrase}" 
                              Background="{DynamicResource CardBackgroundBrush}" 
                              CornerRadius="{StaticResource StandardCornerRadius}" 
                              Padding="28"
                       BorderThickness="1"
                              BorderBrush="{DynamicResource PrimaryAccentBrush}">
                          <StackPanel Spacing="20">

                        <!-- Question/Phrase Section -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="SELECT THE CORRECT CHOICE" 
                                      Foreground="{DynamicResource PrimaryAccentBrush}" 
                                      FontSize="12" 
                                      LetterSpacing="0.5" 
                                      FontWeight="Medium"/>
                            <TextBlock Text="{Binding CurrentPhrase.Definition}" 
                                      FontSize="22" 
                                      FontWeight="SemiBold"
                                      TextWrapping="Wrap"
                                      Foreground="{DynamicResource PrimaryTextColor}"/>
                            <TextBlock Text="{Binding CurrentPhrase.StudyType}" 
                                      FontSize="14" 
                                      TextWrapping="Wrap"
                                      Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>

                        <!-- Answer Options -->
                        <StackPanel Spacing="10">
                            <ItemsControl ItemsSource="{Binding AnswerOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="AnswerOption"
                                               Content="{Binding .}"
                                               Command="{Binding #root.DataContext.SelectAnswerCommand, FallbackValue={x:Null}}"
                                               CommandParameter="{Binding .}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Grid IsVisible="{Binding HasAnswered}">

                            <!-- Feedback Section - Correct Answer -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" IsVisible="{Binding IsAnswerCorrect}"
                            BorderBrush="{DynamicResource CorrectGreenBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource StandardCornerRadius}"
                            Padding="16"
                            Margin="0,12,0,0">
                            <StackPanel Spacing="12" >
                                <TextBlock Text="Correct answer"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource CorrectGreenBrush}"/>
                                <TextBlock Text="{Binding CurrentPhrase.PhraseText}"
                                FontSize="18"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding CurrentPhrase.Examples}"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>
                            
                            
                        </Border>
                        
                        <!-- Feedback Section - Incorrect Answer -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" IsVisible="{Binding !IsAnswerCorrect}"
                        BorderBrush="{DynamicResource ErrorRedBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource StandardCornerRadius}"
                        Padding="16"
                        Margin="0,12,0,0">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Not quite"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource ErrorRedBrush}"/>
                            <TextBlock Text="{Binding CurrentPhrase.PhraseText}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding CurrentPhrase.Examples}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                    
                </Grid>
                        <!-- Review buttons -->
                        <Grid IsVisible="{Binding HasAnswered}" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <Button Grid.Column="0"
                                Classes="ReviewOption Again"
                                Command="{Binding ReviewAgainCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                Content="Again"/>
                            <Button Grid.Column="1"
                                Classes="ReviewOption Hard"
                                Command="{Binding ReviewHardCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                Content="Hard"/>
                            <Button Grid.Column="2"
                                Classes="ReviewOption Good"
                                Command="{Binding ReviewGoodCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                Content="Good"/>
                            <Button Grid.Column="3"
                                Classes="ReviewOption Perfect"
                                Command="{Binding ReviewPerfectCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                Content="Perfect"/>
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>

</UserControl>
