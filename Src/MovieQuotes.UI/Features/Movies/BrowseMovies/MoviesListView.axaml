<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MovieQuotes.UI.Features.Movies.BrowseMovies.MoviesListView"
             xmlns:vm ="using:MovieQuotes.UI.Features.Movies.BrowseMovies" 
             x:DataType="vm:MoviesListViewModel"
             Loaded="MoviesListView_Loaded"
             Background="{DynamicResource AppBackgroundBrush}">

  <Design.DataContext>
    <vm:MoviesListViewModel />
  </Design.DataContext>


  <UserControl.Styles>
    <Style Selector="Button.toolbar-button">
      <Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="CornerRadius" Value="{StaticResource StandardCornerRadius}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.section-count">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto, *, Auto" Margin="24,20">

    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,20">
      <StackPanel Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="Movie library" FontSize="24" FontWeight="Bold"/>
        <TextBlock Text="Browse and manage your local collection"
                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"/>
      </StackPanel>
      <TextBox Grid.Column="1"
               Text="{Binding BaseFolder}"
               PlaceholderText="Select a folder containing movies"
               VerticalAlignment="Center"
               MinHeight="38"/>
      <Button Grid.Column="2" Classes="toolbar-button" Content="Choose folder"
              Command="{Binding ChoseFolderCommand}" VerticalAlignment="Center" />
    </Grid>


    <Border Grid.Row="1">
      <ScrollViewer Margin="0" VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="24">
          <Border Grid.Row="0" IsVisible="{Binding NeedToSync}"
                  Background="{DynamicResource CardBackgroundBrush}"
                  BorderBrush="{DynamicResource ProgressNeedsWorkOrangeColor}" BorderThickness="1"
                  CornerRadius="{StaticResource StandardCornerRadius}" Padding="20">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Movies to import" Classes="section-title" />
                <TextBlock Text="{Binding OutOfSyncMovies.Count,StringFormat='({0})'}" Classes="section-count"/>
              </StackPanel>
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <ProgressBar Height="8" VerticalAlignment="Center"
                             Minimum="0" Maximum="{Binding OutOfSyncMovies.Count}" Value="{Binding Prograss}" />
                <Button Grid.Column="1" Classes="toolbar-button" Content="Import all"
                        Command="{Binding AutoBendingMoviesInsertCommand}" />
              </Grid>
              <ListBox Grid.Row="2" ItemsSource="{Binding OutOfSyncMovies}"
                       Background="Transparent" BorderThickness="0">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Left" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
            </Grid>
          </Border>

          <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="14">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
              <TextBlock Text="Your movie library" Classes="section-title" />
              <TextBlock Grid.Column="1" Text="{Binding DBMovies.Count,StringFormat='({0} loaded)'}" Classes="section-count"/>
              <TextBlock Grid.Column="2" Text="{Binding TotalCountOfMovieInDB,StringFormat='of {0} total'}"
                         Classes="section-count" />
              <TextBox Grid.Column="3" Text="{Binding FilterText}" PlaceholderText="Search movies"
                       Width="220" MinHeight="34">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding GetAllMoviesCommand}"/>
                </TextBox.KeyBindings>
              </TextBox>
            </Grid>
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding DBMovies}" Background="{DynamicResource AppBackgroundColor}">

              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel VerticalAlignment="Top" HorizontalAlignment="Left" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>
          </Grid>
        </Grid>
      </ScrollViewer>
    </Border>


  </Grid>
</UserControl>
