<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MovieQuotes.UI.Features.Movies.BrowseMovies.MoviesListView"
             xmlns:vm ="using:MovieQuotes.UI.Features.Movies.BrowseMovies" 
             x:DataType="vm:MoviesListViewModel"
             Loaded="MoviesListView_Loaded"
             Background="{DynamicResource AppBackground}">

  <Design.DataContext>
    <vm:MoviesListViewModel />
  </Design.DataContext>


  <Grid RowDefinitions="auto, *, auto">

    <Grid ColumnDefinitions="auto,*,auto,auto" Margin="5">
      <TextBlock Text="Base Folder:"
                 VerticalAlignment="Center"
                 Margin="5" />
      <TextBox Grid.Column="1"
               Text="{Binding BaseFolder}"
               Watermark="Folder contains movies"/>
      <Button Grid.Column="2" Content="change folder" Command="{Binding ChoseFolderCommand}" />
    </Grid>


    <Border Grid.Row="1">
      <ScrollViewer Margin="10,0,10,10">
        <Grid   RowDefinitions="auto,auto,auto" >
          <Grid Grid.Row="0" RowDefinitions="auto,auto,auto" IsVisible="{Binding NeedToSync}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Movie Out Of Sync" Classes="title" />
              <TextBlock Text="{Binding OutOfSyncMovies.Count,StringFormat='({0} movies)'}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="1"  Orientation="Horizontal" >
              <ProgressBar  Margin="0 10" Height="20"
                            Minimum="0" Maximum="{Binding OutOfSyncMovies.Count}" Value="{Binding Prograss}"
                            ShowProgressText="True"/>

              <Button Content="Auto Add" Command="{Binding AutoBendingMoviesInsertCommand}" />

             

            </StackPanel>
            <ListBox Grid.Row="2" ItemsSource="{Binding OutOfSyncMovies}" Background="{DynamicResource AppBackgroundColor}" >
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>
          </Grid>

          <Grid Grid.Row="1" RowDefinitions="auto,auto">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Movie In DB" Classes="title" />
              <TextBlock Text="{Binding DBMovies.Count,StringFormat='({0} '}"
                         VerticalAlignment="Center"/>
              <TextBlock Text="{Binding TotalCountOfMovieInDB,StringFormat='out of {0})'}"
                         VerticalAlignment="Center"/>

              <TextBox Watermark="search name 🔍"
                       Height="10"
                       Width="200"
                       Margin="10 0"
                       Text="{Binding FilterText}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding GetAllMoviesCommand}"/>
                </TextBox.KeyBindings>
              </TextBox>
            </StackPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding DBMovies}" Background="{DynamicResource AppBackgroundColor}">

              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>
          </Grid>
        </Grid>
      </ScrollViewer>
    </Border>


  </Grid>
</UserControl>
