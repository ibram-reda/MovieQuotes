<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MovieQuotes.UI.Features.Movies.WatchMovie"
             xmlns:vlc="using:LibVLCSharp.Avalonia"
             xmlns:controls="using:MovieQuotes.UI.Views.Controls"
             x:DataType="vm:WatchMovieViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MovieQuotes.UI.Features.Movies.WatchMovie.WatchMovieView">

  <Grid RowDefinitions="*"  Background="#333">

    <vlc:VideoView Grid.Row="0"
                   Focusable="False"
                   MediaPlayer="{Binding MainMediaPlayer}"
                   VerticalAlignment="Stretch"
                   HorizontalAlignment="Stretch"
                   ZIndex="-1">
      <Grid RowDefinitions="auto,*,auto,auto">
        <Grid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Back to Home" Command="{Binding GoToPreviousCommand}"/>
          </ContextMenu>
        </Grid.ContextMenu>

        <TextBlock Grid.Row="0"
                   Foreground="Orange"
                   HorizontalAlignment="Center"
                   Margin="20"
                   FontSize="24"
                   TextAlignment="Right"
                   FlowDirection="RightToLeft"
                   FontWeight="Bold"
                   IsVisible="{Binding ShowArabicSubs}"
                   Text="{Binding CurrentArPhrase.Text}"/>

        <Panel Grid.Row="1"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Opacity="0.6"
               Background="Gray"
               IsVisible="{Binding ViewContent}">
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto" >

            <ContentControl Content="{Binding CreateStudyMaterial}"/>
          </ScrollViewer>
        </Panel>

        <TextBlock Grid.Row="2"
                   Foreground="Orange"
                   HorizontalAlignment="Center"
                   FontSize="24"
                   FontWeight="Bold"
                   Text="{Binding CurrentPhrase.Text}"/>


        <Grid Grid.Row="3"
              RowDefinitions="50,50"
              ColumnDefinitions="auto,*,auto"
              Margin="10">
          <Slider Grid.Row="0"
                  Grid.ColumnSpan="2"
                  Margin="0"
                  HorizontalAlignment="Stretch"
                  Maximum="{Binding MovieLength}"
                  Value="{Binding CurrentTime}" />

          <StackPanel Grid.Row="0" Spacing="5"
                      Grid.Column="2">

            <Button Content="Add Study Material"
                    Focusable="False"
                    Command="{Binding OpenPopUpCommand}"/>
            <Button Content="Load en subs"
                    IsVisible="{Binding CanLoadEnSubs}"
                    Command="{Binding LoadEnPhrasesCommand}"/>
          </StackPanel>


          <controls:MediaPlayerControls
            Grid.Row="1"
            Grid.Column="0"
            Player="{Binding MainMediaPlayer}"
            NextPhrase="{Binding GoToNextPhraseCommand}"
            PreviousPhrase="{Binding GoToPreviousPhraseCommand}"/>

          <StackPanel Orientation="Horizontal"
                      Grid.Column="2"
                      Grid.Row="1">
            <Button Content="Go Back" Command="{Binding GoToPreviousCommand}"/>
            <TextBlock Text="{Binding CurrentTime,Converter={StaticResource LongToTimeConverter}}"/>

            <TextBlock Text=" of "/>
            <TextBlock Text="{Binding MovieLength,Converter={StaticResource LongToTimeConverter}}"/>

          </StackPanel>
        </Grid>
      </Grid>

    </vlc:VideoView>






  </Grid>
</UserControl>
