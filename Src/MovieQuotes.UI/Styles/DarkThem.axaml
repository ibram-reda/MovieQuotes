
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >

    <Design.PreviewWith>
        <ThemeVariantScope RequestedThemeVariant="Dark">
            <Border Width="1300" Padding="20" Background="{StaticResource AppBackgroundBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Dark theme resources" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="Bold" />

                    <WrapPanel ItemWidth="220" ItemHeight="90" HorizontalAlignment="Left">
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" />
                                <TextBlock Text="AppBackgroundBrush" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" />
                                <TextBlock Text="CardBackgroundBrush" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource PrimaryAccentBrush}" />
                                <TextBlock Text="PrimaryAccentBrush" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="SecondaryTextBrush" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource CorrectGreenBrush}" />
                                <TextBlock Text="CorrectGreenBrush" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource ErrorRedBrush}" />
                                <TextBlock Text="ErrorRedBrush" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource PrimaryTextBrush}" />
                                <TextBlock Text="PrimaryTextBrush" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="Colors" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" />
                    <WrapPanel ItemWidth="220" ItemHeight="78" HorizontalAlignment="Left">
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource AppBackgroundBrush}" />
                                <TextBlock Text="AppBackgroundColor" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource CardBackgroundBrush}" />
                                <TextBlock Text="CardBackgroundColor" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource PrimaryAccentBrush}" />
                                <TextBlock Text="PrimaryAccentPurpleColor" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="SecondaryTextColor" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource CorrectGreenBrush}" />
                                <TextBlock Text="CorrectAnswerTextColor" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource ErrorRedBrush}" />
                                <TextBlock Text="ErrorStatusColor" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource WarningPatternColor}" />
                                <TextBlock Text="WarningPatternColor" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource ProgressStrongColor}" />
                                <TextBlock Text="ProgressStrongColor" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource ProgressGoodColor}" />
                                <TextBlock Text="ProgressGoodColor" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource ProgressExcellentColor}" />
                                <TextBlock Text="ProgressExcellentColor" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource ProgressNeedsWorkOrangeColor}" />
                                <TextBlock Text="ProgressNeedsWorkOrangeColor" Foreground="{StaticResource PrimaryTextBrush}" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource ProgressNeedsWorkRedColor}" />
                                <TextBlock Text="ProgressNeedsWorkRedColor" Foreground="{StaticResource PrimaryTextBrush}" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource HighlightPurpleTextColor}" />
                                <TextBlock Text="HighlightPurpleTextColor" Foreground="{StaticResource PrimaryTextBrush}" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource ErrorStatusColor2}" />
                                <TextBlock Text="ErrorStatusColor2" Foreground="{StaticResource PrimaryTextBrush}" FontSize="10" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource ProgressBackgroundColor}" />
                                <TextBlock Text="ProgressBackgroundColor" Foreground="{StaticResource PrimaryTextBrush}" FontSize="10" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="Fonts" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" />
                    <WrapPanel ItemWidth="220" ItemHeight="90" HorizontalAlignment="Left">
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="ThemePreviewFontFamily" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="{StaticResource ThemePreviewFontFamily}" FontSize="15"/>
                                <TextBlock Text="Segoe UI" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="ThemeCodeFontFamily" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="{StaticResource ThemeCodeFontFamily}" FontSize="15"/>
                                <TextBlock Text="Cascadia Code" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Margin="6" Padding="8" CornerRadius="8" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <TextBlock Text="SymbolThemeFontFamily" Foreground="{StaticResource PrimaryTextBrush}" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="15"/>
                                <TextBlock Text="Segoe Fluent Icons" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

        </ThemeVariantScope>
    </Design.PreviewWith>


    <!-- === Primary & Background Colors === -->
    <!-- Main application background -->
    <Color x:Key="AppBackgroundColor">#131829</Color>
    <!-- Background color for cards, blocks, and text input -->
    <Color x:Key="CardBackgroundColor">#191F33</Color>
    <!-- Main brand/UI accent purple (Buttons, Slider) -->
    <Color x:Key="PrimaryAccentPurpleColor">#7E57C2</Color>
    <!-- Slightly lighter purple for hover/active states -->
    <Color x:Key="ActiveAccentPurpleColor">#8F6AD6</Color>

    <!-- === Text Colors === -->
    <!-- Primary white/light gray for standard text -->
    <Color x:Key="PrimaryTextColor">#E6E7E8</Color>
    <!-- Muted gray for secondary info, labels, and context -->
    <Color x:Key="SecondaryTextColor">#AFC591</Color>
    <!-- Lighter purple used for inline text highlights -->
    <Color x:Key="HighlightPurpleTextColor">#A084E0</Color>
    <!-- Green used for correct answers -->
    <Color x:Key="CorrectAnswerTextColor">#66BB6A</Color>

    <!-- === Feedback & Status Colors === -->
    <!-- Red for error states and incorrect answers -->
    <Color x:Key="ErrorStatusColor">#E57373</Color>
    <Color x:Key="ErrorStatusColor2">#EFEB682B</Color>
    <!-- Yellow for warnings and detected error patterns -->
    <Color x:Key="WarningPatternColor">#FFD54F</Color>

    <!-- === Progress/Skill Meters === -->
    <!-- Green for "Strong" (90%+) -->
    <Color x:Key="ProgressBackgroundColor">#2C3550</Color>
    <Color x:Key="ProgressStrongColor">#4CAF50</Color>
    <!-- Blue for "Good" (80-89%) -->
    <Color x:Key="ProgressGoodColor">#2196F3</Color>
    <!-- Light Green for "Excellent" (95%+) -->
    <Color x:Key="ProgressExcellentColor">#8BC34A</Color>
    <!-- Orange for "Needs Work" (70-79%) -->
    <Color x:Key="ProgressNeedsWorkOrangeColor">#FF9800</Color>
    <!-- Red for "Needs Work" (<70%) -->
    <Color x:Key="ProgressNeedsWorkRedColor">#F44336</Color>



    <!-- === Optional: SolidColorBrush Definitions === -->
    <!-- If you prefer using Brushes directly in your XAML -->

    <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentPurpleColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />

    <SolidColorBrush x:Key="SecondaryTextBrush">#A1A7B3</SolidColorBrush>
    <SolidColorBrush x:Key="CorrectGreenBrush">#66BB6A</SolidColorBrush>
    <SolidColorBrush x:Key="ErrorRedBrush">#E57373</SolidColorBrush>
    <CornerRadius x:Key="StandardCornerRadius">8</CornerRadius>

    <FontFamily x:Key="ThemePreviewFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="ThemeCodeFontFamily">Cascadia Code</FontFamily>

</ResourceDictionary>